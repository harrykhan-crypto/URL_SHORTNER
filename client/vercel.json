{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-API.onrender.com/api/:path*"
    },
    {
      "source": "/:code([A-Za-z0-9_-]{1,32})",
      "destination": "https://YOUR-API.onrender.com/:code"
    }
  ]
}
