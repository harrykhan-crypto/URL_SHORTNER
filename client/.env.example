# Copy to client/.env.local for local development (all optional).

# Where the API lives. Defaults to http://localhost:5000/api in dev and /api
# (proxied by vercel.json) in production.
# VITE_API_URL=http://localhost:5000/api

# Public address of the site, used for SEO tags, robots.txt and sitemap.xml.
# On Vercel this defaults to your production domain automatically.
# VITE_SITE_URL=https://your-site.vercel.app

# Microsoft Clarity project ID. Leave unset to turn analytics off.
# VITE_CLARITY_ID=
